# Token bot dari @BotFather
BOT_TOKEN=

# OPSIONAL. ID grup Telegram tempat bot beroperasi dan mengirim notifikasi jatuh tempo
# (angka negatif untuk grup/supergrup, mis. -1001234567890).
# Kosongkan bila bot mau dipakai langsung lewat chat pribadi: bot hanya akan
# merespons user yang ID-nya ada di ADMIN_IDS, dan pengingat jatuh tempo
# dikirim ke chat pribadi tiap admin tersebut.
GROUP_ID=

# Daftar Telegram user ID admin, dipisah koma.
# Admin bisa menambah/menghapus operator lain lewat bot.
# Wajib diisi bila GROUP_ID dikosongkan.
# Di luar GROUP_ID, hanya ID di daftar ini yang direspons bot.
ADMIN_IDS=

# Zona waktu untuk penjadwalan reminder harian
TZ=Asia/Jakarta

# Lokasi penyimpanan database SQLite dan dokumen
DATA_DIR=./data
DATABASE_URL=file:./data/muamalah.db
