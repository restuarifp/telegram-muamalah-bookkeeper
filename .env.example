# Token bot dari @BotFather
BOT_TOKEN=

# OPSIONAL. ID grup Telegram tempat bot beroperasi dan mengirim notifikasi jatuh tempo
# (angka negatif untuk grup/supergrup, mis. -1001234567890).
# Kosongkan bila bot mau dipakai langsung lewat chat pribadi: bot hanya akan
# merespons user yang ID-nya ada di ADMIN_IDS, dan pengingat jatuh tempo
# dikirim ke chat pribadi tiap admin tersebut.
GROUP_ID=

# Daftar Telegram user ID admin, dipisah koma.
# Admin bisa menambah/menghapus operator lain lewat bot.
# Wajib diisi bila GROUP_ID dikosongkan.
# Di luar GROUP_ID, hanya ID di daftar ini yang direspons bot.
ADMIN_IDS=

# Zona waktu untuk penjadwalan reminder harian
TZ=Asia/Jakarta

# Lokasi penyimpanan database SQLite
DATA_DIR=./data
DATABASE_URL=file:./data/muamalah.db

# --- Nextcloud (penyimpanan dokumen & template akad) ---
# Semua dokumen akad dan template disimpan di Nextcloud, bukan di disk lokal.
# Bot hanya menyimpan path + link berbagi publiknya di database.
NEXTCLOUD_URL=https://alamat.nextcloud
NEXTCLOUD_USER=admin
# Disarankan memakai App Password (Settings > Security > Devices & sessions),
# bukan password login utama.
NEXTCLOUD_PASSWORD=

# Folder akar penyimpanan, relatif terhadap folder milik NEXTCLOUD_USER.
# Subfolder per jenis (Qardh, Investasi, Utang, Piutang, Lainnya) dibuat otomatis.
NEXTCLOUD_BASE_DIR=/Documents/base_dir
# Nama folder template akad di dalam NEXTCLOUD_BASE_DIR.
NEXTCLOUD_TEMPLATE_FOLDER=template_akad
